        mainResult.add(ListTile(
          leading: const Icon(Icons.circle_outlined),
          title: Text(
            "${element["exdia"]}",
            style: const TextStyle(color: Colors.grey),
          ),
          onTap: () {
            setState(() {
              exdia = element["exdia"];
              Navigator.pop(context);
            });
          },
        ));
      } else {
        mainResult.add(ListTile(
          leading: const Icon(Icons.circle_outlined),
          title: Text(
            "${element["exdia"]}",
            style: const TextStyle(color: Colors.black),
          ),
          onTap: () {
            setState(() {
              exdia = element["exdia"];
              Navigator.pop(context);
            });
          },
        ));
      }
    });
    return mainResult;
  }

